# Copy to .env.local for local work, and add the same names in Vercel → Settings → Environment Variables.
# Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server only: cron jobs and payments). Never expose to the browser.
SUPABASE_SECRET_KEY=

# The site address, used in email links
NEXT_PUBLIC_SITE_URL=https://100bephysics.vercel.app

# Daily cron job protection (any long random string)
CRON_SECRET=

# Emails from the site (subscription reminders). https://resend.com
RESEND_API_KEY=
EMAIL_FROM=

# Payments: "manual" until a provider is connected
PAYMENT_PROVIDER=manual

# Stage 4
ANTHROPIC_API_KEY=
