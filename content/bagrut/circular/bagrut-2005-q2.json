          "what": "ב-$B$",
          "why": "הכובד והמתיחות אנכיים, אין רכיב משיקי. התאוצה רדיאלית בלבד, כלפי מעלה",
          "tex": "a = a_R \\uparrow"
        }
      ],
      "finalAnswer": "חץ 1",
      "keyAnswer": "(2) בנקודה B – חץ 1"
    },
    {
      "label": "ד1",
      "question": "חשב את גודל התאוצה של המשקולת בנקודה $A$.",
      "answer": {
        "type": "number",
        "value": 8.660254037844386,
        "unit": "m/s^2"
      },
      "skills": [
        "principle"
      ],
      "solution": [
        {
          "what": "רק תאוצה משיקית",
