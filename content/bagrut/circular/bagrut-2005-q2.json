    {
      "label": "ה",
      "question": "חשב את המתיחות בחוט כאשר המטוטלת יוצרת זווית של $30^\\circ$ עם האנך.",
      "answer": {
        "type": "number",
        "value": 1.5980762113533162,
        "unit": "N"
      },
      "skills": [
        "fbd",
        "principle",
        "algebra"
      ],
      "solution": [
        {
          "what": "המהירות ב-$30^\\circ$",
          "why": "שימור אנרגיה מ-$60^\\circ$",
          "tex": "v^2 = 2g\\ell(\\cos 30^\\circ - \\cos 60^\\circ) \\approx 7.32"
        },
        {
          "what": "משוואה רדיאלית",
          "why": "לאורך החוט, כלפי נקודת התלייה",
          "tex": "T - mg\\cos 30^\\circ = \\frac{m v^2}{\\ell}"
        },
        {
          "what": "מציבים",
          "why": "m = 0.1 kg",
          "tex": "T = 0.1(8.66 + 7.32) \\approx 1.6\\,\\text{N}"
        }
      ],
      "finalAnswer": "$\\approx 1.6\\,\\text{N}$",
      "keyAnswer": "1.6 N"
    },
