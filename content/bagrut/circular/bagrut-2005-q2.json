      "skills": [
        "principle"
      ],
      "solution": [
        {
          "what": "רק תאוצה רדיאלית",
          "why": "אין רכיב משיקי בתחתית",
          "tex": "a_B = \\frac{v_B^2}{\\ell} = \\frac{10}{1} = 10\\,\\text{m/s}^2"
