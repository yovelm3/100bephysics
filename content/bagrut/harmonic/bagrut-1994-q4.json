        {
          "what": "כוח הקפיץ",
          "why": "כלפי מעלה",
          "tex": "F = kx_M = 40 \\cdot 0.25 = 10\\,\\text{N}"
        }
      ],
      "finalAnswer": "$10\\,\\text{N}$ כלפי מעלה",
      "keyAnswer": "F=10 N upward"
    },
    {
      "label": "ב3",
      "question": "חשב את העבודה שעשה התלמיד במשיכת המשקולת מהנקודה $O$ לנקודה $M$.",
