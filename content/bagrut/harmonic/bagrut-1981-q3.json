      ],
      "solution": [
        {
          "what": "זמן מחזור",
          "why": "מטוטלת מתמטית",
          "tex": "T = 2\\pi\\sqrt{\\frac{1}{10}} \\approx 1.99\\,\\text{s}"
        },
        {
          "what": "מהקצה לנקודה הנמוכה",
          "why": "רבע מחזור",
          "tex": "t = \\frac{T}{4} \\approx 0.5\\,\\text{s}"
