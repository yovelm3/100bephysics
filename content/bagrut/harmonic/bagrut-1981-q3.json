      "skills": [
        "fbd",
        "principle",
        "algebra"
      ],
      "solution": [
        {
          "what": "הכוח המחזיר",
          "why": "רכיב הכובד המשיק למסלול",
          "tex": "F = -mg\\sin\\theta \\approx -mg\\theta"
        },
        {
          "what": "העתק לאורך הקשת",
          "why": "$x = \\ell\\theta$",
          "tex": "F \\approx -\\frac{mg}{\\ell}x"
        },
        {
          "what": "כמו קפיץ עם $k = mg/\\ell$",
          "why": "הכוח פרופורציוני להעתק ומכוון אל שיווי המשקל",
          "tex": "T = 2\\pi\\sqrt{\\frac{m}{k}} = 2\\pi\\sqrt{\\frac{\\ell}{g}}"
        }
      ],
      "finalAnswer": "$T = 2\\pi\\sqrt{\\ell/g}$",
      "keyAnswer": null
    },
    {
      "label": "ב",
      "question": "אם המסה הנקודתית $m = 100\\,\\text{g}$, אורך החוט $\\ell = 1\\,\\text{m}$, והזווית בין החוט לאנך היא $\\theta = 5^\\circ$, כמה זמן יעבור מרגע שחרור המסה $m$ עד שהיא תגיע בפעם הראשונה למהירותה המקסימלית?",
      "answer": {
        "type": "number",
