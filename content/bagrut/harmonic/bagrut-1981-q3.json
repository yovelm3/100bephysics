        {
          "what": "תאוצת הכובד בגובה $R$",
          "why": "המרחק מהמרכז כפול",
          "tex": "g' = g\\left(\\frac{R}{2R}\\right)^2 = \\frac{g}{4}"
        },
        {
          "what": "זמן המחזור",
          "why": "$T \\propto 1/\\sqrt{g}$",
          "tex": "T' = 2\\pi\\sqrt{\\frac{\\ell}{g/4}} = 2T \\approx 3.97\\,\\text{s}"
