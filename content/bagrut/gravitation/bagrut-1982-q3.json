  "needsReview": true,
  "reviewNotes": "טיוטה: נוסח, פתרון וציור של Claude, ממתין לאישור הבעלים.",
  "stem": "לוויין בעל מסה $m = 10^3\\,\\text{kg}$ מקיף את כדור הארץ במשך זמן $T_1$, במסלול מעגלי שרדיוסו $R_1$. כדי להעלות את הלוויין ממסלולו זה למסלול מעגלי שרדיוסו $R_2$ ($R_2 > R_1$), דרושה אנרגיה של $\\Delta E = 6 \\times 10^9\\,\\text{J}$. זמן המחזור במסלול החדש הוא $T_2$. (הנח: $g = 10\\,\\text{m/s}^2$ על פני כדור הארץ, ורדיוס כדור הארץ $6400\\,\\text{km}$.)",
  "figure": null,
  "authorNote": null,
  "concepts": [
    "החוק השלישי של קפלר",
    "אנרגיה של לוויין",
    "שינוי מסלול",
    "שילוח"
  ],
  "summary": "העברת לוויין למסלול גבוה יותר: רדיוס מקפלר ומהפרש אנרגיות, זמן המחזור, והאנרגיה לשילוח מהקרקע.",
  "position": 3,
  "parts": [
    {
      "label": "א",
      "question": "מהו הרדיוס $R_1$ של המסלול הראשון של הלוויין, אם ידוע כי היחס בין זמני המחזור של שני המסלולים הוא $\\frac{T_2}{T_1} = 8$?",
      "answer": {
        "type": "number",
        "value": 25600000.0,
        "unit": "m"
      },
      "skills": [
        "principle",
        "algebra"
      ],
      "solution": [
        {
          "what": "החוק השלישי של קפלר",
          "why": "T² ∝ R³",
          "tex": "\\left(\\frac{R_2}{R_1}\\right)^3 = \\left(\\frac{T_2}{T_1}\\right)^2 = 64 \\Rightarrow R_2 = 4R_1"
        },
        {
          "what": "אנרגיה של לוויין במסלול מעגלי",
          "why": "קינטית ועוד פוטנציאלית",
          "tex": "E = -\\frac{GMm}{2R}"
        },
        {
          "what": "ההפרש",
          "why": "R_2 = 4R_1",
          "tex": "\\Delta E = \\frac{GMm}{2}\\left(\\frac{1}{R_1} - \\frac{1}{4R_1}\\right) = \\frac{3GMm}{8R_1}"
        },
        {
          "what": "פותרים",
          "why": "$GM = gR^2 \\approx 4.1 \\times 10^{14}$",
          "tex": "R_1 = \\frac{3 \\cdot 4.1 \\times 10^{14} \\cdot 10^3}{8 \\cdot 6 \\times 10^9} \\approx 2.56 \\times 10^7\\,\\text{m}"
        }
      ],
      "finalAnswer": "$\\approx 2.56 \\times 10^7\\,\\text{m}$",
      "keyAnswer": "2.56×10^7 m"
    },
    {
      "label": "ב",
      "question": "מהו זמן המחזור $T_1$ של הלוויין במסלולו הראשון?",
      "answer": {
        "type": "number",
        "value": 40212.385965949354,
        "unit": "s"
      },
      "skills": [
        "principle"
      ],
      "solution": [
        {
          "what": "זמן מחזור במסלול מעגלי",
          "why": "כבידה ככוח צנטריפטלי",
          "tex": "T_1 = 2\\pi\\sqrt{\\frac{R_1^3}{GM}} \\approx 2\\pi \\cdot 6400 \\approx 40200\\,\\text{s}"
        }
      ],
      "finalAnswer": "$\\approx 40200\\,\\text{s}$",
      "keyAnswer": "40200 s"
    },
    {
      "label": "ג",
      "question": "מהי האנרגיה שהייתה דרושה כדי להעלות את הלוויין מכן-השילוח שעל פני כדור הארץ ולהכניסו למסלול ההקפה הראשון שלו?",
      "answer": {
        "type": "number",
        "value": 56000000000.00001,
        "unit": "J"
      },
      "skills": [
        "principle"
      ],
      "solution": [
        {
          "what": "על פני כדור הארץ",
          "why": "במנוחה (מזניחים את סיבוב כדור הארץ)",
          "tex": "E_0 = -\\frac{GMm}{R}"
        },
        {
          "what": "במסלול",
          "why": "מסלול מעגלי ברדיוס R_1",
          "tex": "E_1 = -\\frac{GMm}{2R_1}"
        },
        {
          "what": "ההפרש",
          "why": "האנרגיה שצריך להוסיף",
          "tex": "E_1 - E_0 = GMm\\left(\\frac{1}{R} - \\frac{1}{2R_1}\\right) \\approx 5.6 \\times 10^{10}\\,\\text{J}"
        }
      ],
      "finalAnswer": "$\\approx 5.6 \\times 10^{10}\\,\\text{J}$",
      "keyAnswer": "5.6×10^10 J"
    }
  ]
}
