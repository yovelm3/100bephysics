          "tex": "\\tfrac{1}{2} \\cdot 1.6\\,\\frac{GM}{R} - \\frac{GM}{R} = 0 - \\frac{GM}{r} \\;\\Rightarrow\\; r = 5R",
          "eq": "U = -\\frac{GMm}{r}"
        },
        {
          "what": "הגובה מעל הפנים",
          "why": "מהמרחק מהמרכז מחסירים את הרדיוס",
          "tex": "h = 5R - R = 4R"
        }
      ],
      "finalAnswer": "אנכית, לגובה $4R$ מעל פני הכוכב",
      "keyAnswer": "4R מפני הכוכב"
