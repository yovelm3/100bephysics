    {
      "label": "א",
      "question": "מה היחס $g_A/g_B$ בין תאוצות הנפילה החופשית על פני שני הכוכבים?",
      "answer": {
        "type": "choice",
        "choices": [
          "$\\frac{\\rho_A R_A}{\\rho_B R_B}$",
          "$\\frac{\\rho_A R_A^2}{\\rho_B R_B^2}$",
          "$\\frac{\\rho_A R_B}{\\rho_B R_A}$",
          "$\\frac{R_A}{R_B}$"
        ],
        "correct": 0
      },
      "skills": [
        "principle",
        "algebra"
      ],
      "solution": [
        {
          "what": "מסת הכוכב",
          "why": "המסה היא הצפיפות כפול הנפח של כדור",
          "tex": "M = \\rho \\cdot \\tfrac{4}{3}\\pi R^3"
        },
        {
          "what": "תאוצת הנפילה על פני הכוכב",
          "why": "מציבים את המסה, ומצמצמים רדיוס בריבוע",
          "tex": "g = \\frac{GM}{R^2} = \\tfrac{4}{3}\\pi G\\rho R",
          "eq": "g^* = \\frac{GM}{r^2}"
        },
        {
          "what": "היחס",
          "why": "מחלקים, והקבועים מצטמצמים",
          "tex": "\\frac{g_A}{g_B} = \\frac{\\rho_A R_A}{\\rho_B R_B}"
        }
      ],
      "finalAnswer": "$\\frac{\\rho_A R_A}{\\rho_B R_B}$",
      "keyAnswer": "ρA·RA/(ρB·RB)"
    },
    {
      "label": "ב",
      "question": "קרוב לפני כל כוכב נע לוויין במסלול מעגלי. מה היחס $T_A/T_B$ בין זמני המחזור של שני הלוויינים?",
