      "solution": [
        {
          "explain": "ימינה הוא הכיוון החיובי. הקפיץ מחזיר את כל האנרגיה שנאגרה בו, ולכן ההתנגשות אלסטית."
        },
        {
          "what": "שימור תנע",
          "why": "הכוחות בין הגופים הם פנימיים, ואין חיכוך",
          "tex": "2 \\cdot 10 + 6 \\cdot 4 = 2\\,u_A + 6\\,u_B",
          "eq": "m_A\\vec v_A + m_B\\vec v_B = m_A\\vec u_A + m_B\\vec u_B"
        },
        {
          "what": "התנגשות אלסטית",
          "why": "מהירות ההתקרבות שווה למהירות ההתרחקות",
          "tex": "10 - 4 = -(u_A - u_B) \\;\\Rightarrow\\; u_B = u_A + 6",
          "eq": "v_A - v_B = -(u_A - u_B)"
        },
        {
          "what": "פותרים",
          "why": "מציבים את המשוואה השנייה בראשונה",
          "tex": "44 = 2\\,u_A + 6\\,(u_A + 6) \\;\\Rightarrow\\; 8\\,u_A = 8 \\;\\Rightarrow\\; u_A = 1\\,\\text{m/s}"
        }
      ],
      "finalAnswer": "$1\\,\\text{m/s}$ ימינה",
      "keyAnswer": "u1=1 m/s"
    },
